{
  "name": "notch",
  "version": "1.2.19",
  "private": true,
  "description": "A glass notch for Windows — hover the top of your screen.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node dev-server.js",
    "dist": "electron-builder --win --publish never",
    "dist:installer": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.3",
    "kokoro-js": "^1.2.1"
  },
  "build": {
    "appId": "com.notch.windows",
    "productName": "Notch",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "games.js",
      "*preload.js",
      "winhook.ps1",
      "src/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "tts",
        "to": "tts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Notch-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notch",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Notch-${version}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
